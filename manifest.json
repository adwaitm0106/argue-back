{
  "manifest_version": 3,
  "name": "Argue Back",
  "version": "2.0.0",
  "description": "Take apart any AI answer four ways: watch it delete its own filler, see its rejected drafts, watch it get rephrased, or see what it knows versus what it's guessing.",
  "permissions": [
    "storage",
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://copilot.microsoft.com/*",
    "https://chat.deepseek.com/*",
    "https://grok.com/*",
    "https://chat.mistral.ai/*",
    "https://www.google.com/search*",
    "https://www.google.co.in/search*",
    "https://www.google.co.uk/search*",
    "https://www.google.ca/search*",
    "https://www.google.com.au/search*",
    "https://www.google.de/search*",
    "https://www.google.fr/search*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Argue Back settings"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://copilot.microsoft.com/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*",
        "https://chat.mistral.ai/*",
        "https://www.google.com/search*",
        "https://www.google.co.in/search*",
        "https://www.google.co.uk/search*",
        "https://www.google.ca/search*",
        "https://www.google.com.au/search*",
        "https://www.google.de/search*",
        "https://www.google.fr/search*"
      ],
      "js": [
        "utils.js",
        "analyzer.js",
        "modes.js",
        "content_script.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
